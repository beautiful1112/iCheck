[Unit]
Description=iCheck regional Prometheus metrics service
After=network-online.target icheck-snmp-exporter.service
Wants=network-online.target

[Service]
Type=simple
User=icheck
Group=icheck
ExecStart=/opt/icheck/bin/prometheus --config.file=/etc/icheck/prometheus/prometheus.yml --storage.tsdb.path=/var/lib/icheck/prometheus --storage.tsdb.retention.time=15d --storage.tsdb.retention.size=10GB --web.listen-address=127.0.0.1:9090
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/icheck/prometheus

[Install]
WantedBy=multi-user.target
