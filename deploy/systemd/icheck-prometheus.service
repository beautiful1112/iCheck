[Unit]
Description=iCheck regional Prometheus metrics service
After=network-online.target icheck-snmp-exporter.service
Wants=network-online.target

[Service]
Type=simple
User=icheck-prometheus
Group=icheck-prometheus
ExecStart=/opt/icheck/bin/prometheus --config.file=/etc/icheck-workers/prometheus/prometheus.yml --storage.tsdb.path=/var/lib/icheck-prometheus --storage.tsdb.retention.time=15d --storage.tsdb.retention.size=10GB --web.listen-address=127.0.0.1:9090
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
StateDirectory=icheck-prometheus
StateDirectoryMode=0700
ReadWritePaths=/var/lib/icheck-prometheus

[Install]
WantedBy=multi-user.target
