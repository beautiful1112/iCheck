[Unit]
Description=iCheck authenticated MCP contract attestor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=icheck-mcp-attestor
Group=icheck-mcp-attestor
UMask=0077
WorkingDirectory=/opt/icheck
EnvironmentFile=/etc/icheck/mcp-attestor.env
ExecStart=/opt/icheck/.venv/bin/icheck-mcp-attestor
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
