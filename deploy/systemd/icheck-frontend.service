[Unit]
Description=iCheck native AI operations frontend
After=network-online.target icheck-control-plane.service
Wants=network-online.target

[Service]
Type=simple
User=icheck-frontend
Group=icheck-frontend
UMask=0077
WorkingDirectory=/opt/icheck/frontend
EnvironmentFile=/etc/icheck/frontend.env
ExecStart=/opt/icheck/node/bin/node /opt/icheck/frontend/start.mjs
Restart=on-failure
RestartSec=5
# Next.js exits 128 + SIGTERM (143) after graceful shutdown.
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Keep only the active release cache writable across version-pointer switches.
# Validate symlink resolution under the installed systemd namespace before use.
ReadWritePaths=/opt/icheck/frontend/.next/cache

[Install]
WantedBy=multi-user.target
