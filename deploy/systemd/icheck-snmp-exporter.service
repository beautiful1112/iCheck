[Unit]
Description=iCheck site-local Prometheus SNMP Exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=icheck
Group=icheck
EnvironmentFile=-/etc/icheck/secrets/snmp-exporter.env
ExecStart=/opt/icheck/bin/snmp_exporter --config.file=/etc/icheck/snmp/snmp.yml --config.expand-environment-variables --web.listen-address=127.0.0.1:9116
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
