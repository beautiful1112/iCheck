[Unit]
Description=iCheck managed Agent capacity instance %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=icheck-agent
Group=icheck-agent
UMask=0077
WorkingDirectory=/opt/icheck
EnvironmentFile=/etc/icheck/capacity/agent-common.env
EnvironmentFile=-/etc/icheck/capacity/agent-%i.env
ExecStart=/opt/icheck/.venv/bin/icheck-agent-worker --name capacity-agent-%i
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=icheck-agent
StateDirectoryMode=0700
ReadWritePaths=/var/lib/icheck-agent

[Install]
WantedBy=multi-user.target
