ICHECK_ENVIRONMENT=production
ICHECK_AUTO_CREATE_SCHEMA=false
ICHECK_CONTROL_PLANE_AUTH_MODE=required
ICHECK_CONTROL_PLANE_SESSION_COOKIE_SECURE=true
ICHECK_REQUIRE_GOVERNED_CHANGE_CONTRACTS=true
# Separate non-owner login, provisioned with worker-grants --profile ecosystem-transport-worker.
# Keep its password and outbound Vault/TLS custody in this private component environment.
ICHECK_DATABASE_URL=postgresql+psycopg://icheck_ecosystem_transport@127.0.0.1:5432/icheck?sslmode=require
ICHECK_TENANT_ID=00000000-0000-0000-0000-000000000001
ICHECK_REGION_ID=00000000-0000-0000-0000-000000000002
ICHECK_ECOSYSTEM_TRANSPORT_ALLOWED_HOSTS=witness1.example.net,witness2.example.net,production-api.example.net
ICHECK_ECOSYSTEM_TRANSPORT_WORKER_NAME=ecosystem-transport-worker-01
ICHECK_ECOSYSTEM_TRANSPORT_WORKER_BATCH_SIZE=20
ICHECK_ECOSYSTEM_TRANSPORT_WORKER_LEASE_SECONDS=120
ICHECK_ECOSYSTEM_TRANSPORT_WORKER_POLL_SECONDS=1
ICHECK_SERVER_SECRET_VAULT_ADDRESS=https://vault.example.internal
ICHECK_SERVER_SECRET_VAULT_TOKEN_FILE=/etc/icheck-workers/ecosystem-transport/vault-token
ICHECK_SERVER_SECRET_VAULT_NAMESPACE=operations
ICHECK_SERVER_SECRET_VAULT_TIMEOUT_SECONDS=5
ICHECK_LOG_LEVEL=INFO
