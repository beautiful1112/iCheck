[Unit]
Description=iCheck governed Ansible Runner MCP action adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=icheck-actions
Group=icheck-actions
WorkingDirectory=/opt/icheck
EnvironmentFile=/etc/icheck/ansible-adapter.env
ExecStart=/opt/icheck/.venv/bin/icheck-ansible-adapter
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=10s
SendSIGKILL=yes
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/etc/icheck-workers/actions
StateDirectory=icheck-actions
StateDirectoryMode=0700
ReadWritePaths=/var/lib/icheck-actions

[Install]
WantedBy=multi-user.target

