ICHECK_ENVIRONMENT=production
ICHECK_AUTO_CREATE_SCHEMA=false
# Dedicated core role: provision with icheck-db worker-grants --profile quality-worker.
# Install the password-bearing URL in a root-owned component environment only.
# Never copy this file to an Agent Worker or generated capability.
ICHECK_DATABASE_URL=postgresql+psycopg://icheck_quality@127.0.0.1:5432/icheck?sslmode=require
ICHECK_CONTROL_PLANE_AUTH_MODE=required
ICHECK_CONTROL_PLANE_SESSION_COOKIE_SECURE=true
ICHECK_REQUIRE_GOVERNED_CHANGE_CONTRACTS=true
ICHECK_TENANT_ID=00000000-0000-0000-0000-000000000001
ICHECK_REGION_ID=00000000-0000-0000-0000-000000000002
