ICHECK_ENVIRONMENT=production
ICHECK_AUTO_CREATE_SCHEMA=false
ICHECK_CONTROL_PLANE_AUTH_MODE=required
ICHECK_CONTROL_PLANE_SESSION_COOKIE_SECURE=true
ICHECK_REQUIRE_GOVERNED_CHANGE_CONTRACTS=true
ICHECK_CONTROL_PLANE_URL=https://icheck-control.example.internal
ICHECK_WORKER_TLS_CA_FILE=/etc/icheck-workers/collector/worker-ca.pem
ICHECK_WORKER_TLS_CERT_FILE=/etc/icheck-workers/collector/collector.pem
ICHECK_WORKER_TLS_KEY_FILE=/etc/icheck-workers/collector/collector.key
# ICHECK_WORKER_TLS_KEY_PASSWORD_FILE=/etc/icheck-workers/collector/collector-key-password
ICHECK_TENANT_ID=00000000-0000-0000-0000-000000000001
ICHECK_REGION_ID=00000000-0000-0000-0000-000000000002
ICHECK_COLLECTOR_NAME=collector-hkg-01
ICHECK_COLLECTOR_SITE=HKG
ICHECK_COLLECTOR_CAPABILITIES=http_json,http_json_sandbox,ssh_command_sandbox,snmp_exporter,snmp_topology,windows_exporter,psrp_cim
# Add node_exporter,cadvisor,vmware_exporter only when explicitly provisioning
# their monitoring tests. These are preflight-only; Prometheus scrapes metrics.
# Optional icmp and ssh are reachability/transport preflights, not collection
# adapters. ICMP requires ping and an authorized non-root ICMP socket; it is
# never enabled automatically or granted root/raw-socket privileges here.
ICHECK_COLLECTOR_POLL_SECONDS=5
ICHECK_COLLECTOR_LEASE_SECONDS=60
ICHECK_COLLECTOR_MAX_ASSIGNMENTS=4
ICHECK_COLLECTOR_MAX_PREFLIGHTS=4
ICHECK_COLLECTOR_PREFLIGHT_TIMEOUT_SECONDS=5
ICHECK_COLLECTOR_PREFLIGHT_ALLOWED_TARGETS=10.0.0.0/8,192.168.0.0/16
ICHECK_COLLECTOR_PREFLIGHT_SNMP_EXPORTER_URL=http://127.0.0.1:9116
ICHECK_COLLECTOR_HTTP_ALLOWED_HOSTS=inventory.example.internal,*.monitoring.example.internal
ICHECK_COLLECTOR_EXPORTER_ALLOWED_HOSTS=127.0.0.1,localhost
ICHECK_COLLECTOR_SNMP_ALLOWED_TARGETS=10.0.0.0/8,192.168.0.0/16
ICHECK_COLLECTOR_WINDOWS_EXPORTER_ALLOWED_HOSTS=10.20.0.0/16
ICHECK_COLLECTOR_WINDOWS_ALLOWED_TARGETS=10.20.0.0/16
ICHECK_COLLECTOR_PSRP_ALLOWED_PORTS=5986
ICHECK_COLLECTOR_PSRP_AUTH=ntlm
ICHECK_COLLECTOR_PSRP_CONFIGURATION_NAME=Microsoft.PowerShell
# ICHECK_COLLECTOR_PSRP_CA_FILE=/etc/icheck-workers/collector/windows-winrm-ca.pem
ICHECK_COLLECTOR_SSH_ALLOWED_TARGETS=10.0.0.0/8,192.168.0.0/16
ICHECK_COLLECTOR_SSH_KNOWN_HOSTS_FILE=/etc/icheck-workers/collector/ssh_known_hosts
ICHECK_COLLECTOR_REGISTRATION_TOKEN_FILE=/etc/icheck-workers/collector/collector-registration-token
ICHECK_CREDENTIAL_VAULT_ADDR=https://vault.example.internal
ICHECK_CREDENTIAL_VAULT_TOKEN_FILE=/etc/icheck-workers/collector/vault-token
ICHECK_CREDENTIAL_VAULT_NAMESPACE=operations
ICHECK_CREDENTIAL_VAULT_TIMEOUT_SECONDS=5
ICHECK_CREDENTIAL_ALLOW_ENVIRONMENT=false
ICHECK_SANDBOX_ENABLED=true
ICHECK_SANDBOX_BACKEND=process
ICHECK_SANDBOX_BWRAP_PATH=/usr/bin/bwrap
ICHECK_SANDBOX_PYTHON_PATH=/usr/bin/python3
ICHECK_SANDBOX_TIMEOUT_SECONDS=5
