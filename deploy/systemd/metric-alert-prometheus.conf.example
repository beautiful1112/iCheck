# Optional /etc/systemd/system/icheck-prometheus.service.d/metric-alerts.conf
# Review against the actual installed ExecStart; preserve its data and retention.
# Lifecycle is loopback-only, not separately authenticated. Trusted lab host only.
[Service]
ExecStart=
ExecStart=/opt/icheck/bin/prometheus --config.file=/etc/icheck-workers/prometheus/prometheus.yml --storage.tsdb.path=/var/lib/icheck-prometheus --storage.tsdb.retention.time=15d --storage.tsdb.retention.size=10GB --web.listen-address=127.0.0.1:9090 --web.enable-lifecycle
