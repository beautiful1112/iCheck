ICHECK_ENVIRONMENT=production
ICHECK_AUTO_CREATE_SCHEMA=false
ICHECK_CONTROL_PLANE_AUTH_MODE=required
ICHECK_CONTROL_PLANE_SESSION_COOKIE_SECURE=true
ICHECK_REQUIRE_GOVERNED_CHANGE_CONTRACTS=true
ICHECK_CONTROL_PLANE_URL=https://icheck-control.example.internal
ICHECK_MCP_ATTESTOR_ALLOW_INSECURE_CONTROL_PLANE=false
ICHECK_WORKER_TLS_CA_FILE=/etc/icheck-workers/mcp-attestor/worker-ca.pem
ICHECK_WORKER_TLS_CERT_FILE=/etc/icheck-workers/mcp-attestor/mcp-attestor.pem
ICHECK_WORKER_TLS_KEY_FILE=/etc/icheck-workers/mcp-attestor/mcp-attestor.key
ICHECK_WORKER_TLS_KEY_PASSWORD_FILE=
ICHECK_MCP_ATTESTOR_REGISTRATION_TOKEN_FILE=/etc/icheck-workers/mcp-attestor/mcp-attestor-registration-token
ICHECK_TENANT_ID=00000000-0000-0000-0000-000000000001
ICHECK_REGION_ID=00000000-0000-0000-0000-000000000002
ICHECK_MCP_ATTESTOR_NAME=mcp-attestor-01
ICHECK_MCP_ATTESTOR_MAX_ASSIGNMENTS=4
ICHECK_MCP_ATTESTOR_LEASE_SECONDS=120
ICHECK_MCP_ATTESTOR_POLL_SECONDS=2
ICHECK_MCP_ALLOWED_HOSTS=mcp-gateway.example.internal
ICHECK_MCP_OAUTH_ALLOWED_HOSTS=mcp-gateway.example.internal,login.example.internal
ICHECK_CREDENTIAL_VAULT_ADDR=https://vault.example.internal
ICHECK_CREDENTIAL_VAULT_TOKEN_FILE=/etc/icheck-workers/mcp-attestor/vault-token
ICHECK_CREDENTIAL_VAULT_NAMESPACE=operations
ICHECK_CREDENTIAL_VAULT_TIMEOUT_SECONDS=5
ICHECK_CREDENTIAL_ALLOW_ENVIRONMENT=false
ICHECK_LOG_LEVEL=INFO
