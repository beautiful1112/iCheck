ICHECK_ENVIRONMENT=production
ICHECK_AUTO_CREATE_SCHEMA=false
ICHECK_CONTROL_PLANE_AUTH_MODE=required
ICHECK_CONTROL_PLANE_SESSION_COOKIE_SECURE=true
ICHECK_REQUIRE_GOVERNED_CHANGE_CONTRACTS=true
# Provision a separate non-owner login with worker-grants --profile systemd-capacity-provider.
# Supply its password only in the protected component environment, never the API/Agent credential.
ICHECK_DATABASE_URL=postgresql+psycopg://icheck_capacity@127.0.0.1:5432/icheck?sslmode=require
ICHECK_TENANT_ID=00000000-0000-0000-0000-000000000001
ICHECK_REGION_ID=00000000-0000-0000-0000-000000000002
ICHECK_SYSTEMD_CAPACITY_NODE_ID=worker-host-hkg-01
ICHECK_SYSTEMD_CAPACITY_CONFIG=/etc/icheck-workers/capacity/systemd-capacity.json
ICHECK_SYSTEMD_CAPACITY_SYSTEMCTL_PATH=/usr/bin/systemctl
ICHECK_SYSTEMD_CAPACITY_POLL_SECONDS=15
ICHECK_SYSTEMD_CAPACITY_APPLY_TIMEOUT_SECONDS=300
ICHECK_LOG_LEVEL=INFO
