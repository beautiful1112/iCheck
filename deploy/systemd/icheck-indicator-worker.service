[Unit]
Description=iCheck governed service indicator worker
After=network-online.target postgresql.service icheck-prometheus.service
Wants=network-online.target

[Service]
Type=simple
User=icheck-indicator
Group=icheck-indicator
UMask=0077
WorkingDirectory=/opt/icheck
EnvironmentFile=/etc/icheck/indicator-worker.env
ExecStart=/opt/icheck/.venv/bin/icheck-indicator-worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=icheck-indicator
StateDirectoryMode=0700
ReadWritePaths=/var/lib/icheck-indicator

[Install]
WantedBy=multi-user.target
