ICHECK_ENVIRONMENT=production
ICHECK_AUTO_CREATE_SCHEMA=false
ICHECK_CONTROL_PLANE_AUTH_MODE=required
ICHECK_CONTROL_PLANE_SESSION_COOKIE_SECURE=true
ICHECK_REQUIRE_GOVERNED_CHANGE_CONTRACTS=true
# Dedicated trusted internal controller login, provisioned by the owner with
# `icheck-db worker-grants --profile workflow-dispatch-worker`. Never reuse the
# API/owner login. Use a protected EnvironmentFile; no secret values in source.
ICHECK_DATABASE_URL=postgresql+psycopg://icheck_workflow_dispatch@127.0.0.1:5432/icheck?sslmode=require
ICHECK_TENANT_ID=00000000-0000-0000-0000-000000000001
ICHECK_REGION_ID=00000000-0000-0000-0000-000000000002
ICHECK_WORKFLOW_DISPATCH_BATCH_SIZE=20
ICHECK_WORKFLOW_DISPATCH_POLL_SECONDS=2
ICHECK_LOG_LEVEL=INFO
