# Install the native standalone package, not the hosted dist output.
# Node.js >=22.13 must be installed at the service's ExecStart path.
ICHECK_FRONTEND_HOST=127.0.0.1
ICHECK_FRONTEND_PORT=3000
# The public API base is fixed at build time; do not put AI tokens here.
# Route /api/v1 through the trusted TLS ingress to the control plane.
