# Merge reviewed values into the protected existing control-plane environment.
# Replace identifiers with the actual trusted workspace/Prometheus backend.
ICHECK_METRIC_RULE_DIRECTORY=/var/lib/icheck-metric-rules
ICHECK_METRIC_RULE_BACKEND_ID=REPLACE_WITH_EXISTING_PROMETHEUS_BACKEND_ID
ICHECK_METRIC_RULE_TENANT_ID=REPLACE_WITH_WORKSPACE_TENANT_ID
ICHECK_METRIC_RULE_REGION_ID=REPLACE_WITH_WORKSPACE_REGION_ID
