[Unit]
Description=Grafana OSS for iCheck engineering monitoring
After=network-online.target icheck-prometheus.service
Wants=network-online.target

[Service]
Type=simple
User=icheck-grafana
Group=icheck-grafana
UMask=0077
WorkingDirectory=/opt/icheck/grafana
ExecStart=/opt/icheck/grafana/bin/grafana server --homepath=/opt/icheck/grafana --config=/etc/icheck-grafana/grafana.ini
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
StateDirectory=icheck-grafana
StateDirectoryMode=0700
ReadWritePaths=/var/lib/icheck-grafana
MemoryMax=1G
TasksMax=256
LimitNOFILE=10000

[Install]
WantedBy=multi-user.target
