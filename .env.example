ICHECK_DATABASE_URL=postgresql+psycopg://icheck:icheck@localhost:5432/icheck
ICHECK_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ICHECK_AUTO_CREATE_SCHEMA=true
ICHECK_COLLECTOR_REGISTRATION_TOKEN=replace-with-a-long-random-bootstrap-token
ICHECK_AGENT_REGISTRATION_TOKEN=replace-with-a-separate-agent-bootstrap-token
ICHECK_MCP_ATTESTOR_REGISTRATION_TOKEN=replace-with-a-dedicated-attestor-bootstrap-token
ICHECK_WORKER_MTLS_MODE=disabled
ICHECK_WORKER_MTLS_TRUSTED_PROXIES=127.0.0.1/32,::1/128
ICHECK_CONTROL_PLANE_AUTH_MODE=required
ICHECK_CONTROL_PLANE_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-token
ICHECK_CONTROL_PLANE_DEFAULT_TOKEN_TTL_HOURS=720
ICHECK_CONTROL_PLANE_BROWSER_SESSION_TTL_HOURS=12
ICHECK_CONTROL_PLANE_SESSION_COOKIE_SECURE=false
ICHECK_CONTROL_PLANE_SESSION_COOKIE_SAMESITE=strict
ICHECK_CONTROL_PLANE_PASSWORD_LOGIN_ENABLED=true
ICHECK_CONTROL_PLANE_PASSWORD_LOGIN_TENANT=local
# Legacy API-only token-to-cookie exchange, never the default web login.
ICHECK_CONTROL_PLANE_LOCAL_BROWSER_LOGIN_ENABLED=false
ICHECK_CONTROL_PLANE_OIDC_ENABLED=false
ICHECK_CONTROL_PLANE_OIDC_DISPLAY_NAME=Enterprise SSO
ICHECK_CONTROL_PLANE_OIDC_ISSUER=
ICHECK_CONTROL_PLANE_OIDC_CLIENT_ID=
ICHECK_CONTROL_PLANE_OIDC_CLIENT_SECRET_FILE=
ICHECK_CONTROL_PLANE_OIDC_TRANSACTION_SECRET_FILE=
ICHECK_CONTROL_PLANE_OIDC_REDIRECT_URI=
ICHECK_CONTROL_PLANE_OIDC_SUCCESS_URL=
ICHECK_CONTROL_PLANE_OIDC_ALLOWED_HOSTS=
ICHECK_CONTROL_PLANE_OIDC_SCOPES=openid profile email
ICHECK_CONTROL_PLANE_OIDC_MAX_PENDING_TRANSACTIONS=10000
ICHECK_CONTROL_PLANE_TRUSTED_PROXY_ENABLED=false
ICHECK_CONTROL_PLANE_TRUSTED_PROXY_DISPLAY_NAME=Corporate identity gateway
ICHECK_CONTROL_PLANE_TRUSTED_PROXY_ISSUER=icheck-edge
ICHECK_CONTROL_PLANE_TRUSTED_PROXY_SUCCESS_URL=http://localhost:3000
ICHECK_CONTROL_PLANE_TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128
ICHECK_CONTROL_PLANE_TRUSTED_PROXY_SHARED_SECRET_FILES=/etc/icheck/secrets/trusted-proxy-current
ICHECK_CONTROL_PLANE_WORKLOAD_OIDC_ENABLED=false
ICHECK_CONTROL_PLANE_WORKLOAD_OIDC_ISSUER=https://token.actions.githubusercontent.com
ICHECK_CONTROL_PLANE_WORKLOAD_OIDC_AUDIENCE=icheck-ci
ICHECK_CONTROL_PLANE_WORKLOAD_OIDC_ALLOWED_HOSTS=token.actions.githubusercontent.com
ICHECK_CONTROL_PLANE_WORKLOAD_OIDC_TIMEOUT_SECONDS=10
ICHECK_CONTROL_PLANE_WORKLOAD_TOKEN_TTL_MINUTES=15
ICHECK_SANDBOX_ENABLED=false
ICHECK_SANDBOX_BACKEND=process
ICHECK_SANDBOX_BWRAP_PATH=/usr/bin/bwrap
ICHECK_SANDBOX_PYTHON_PATH=/usr/bin/python3
ICHECK_SANDBOX_TIMEOUT_SECONDS=5
# Optional native MCP packages: pre-provision this absolute directory mode 0700
# for the control-plane service user; install the pinned extensions dependencies.
# ICHECK_EXTENSION_PACKAGES_ROOT=/var/lib/icheck/extensions
NEXT_PUBLIC_ICHECK_API_URL=http://localhost:8000/api/v1
ICHECK_CONTROL_PLANE_URL=http://localhost:8000
ICHECK_WORKER_TLS_CA_FILE=
ICHECK_WORKER_TLS_CERT_FILE=
ICHECK_WORKER_TLS_KEY_FILE=
ICHECK_WORKER_TLS_KEY_PASSWORD_FILE=
ICHECK_COLLECTOR_NAME=collector-local-01
ICHECK_COLLECTOR_SITE=LOCAL
ICHECK_COLLECTOR_CAPABILITIES=http_json,snmp_exporter,snmp_topology,windows_exporter
ICHECK_COLLECTOR_POLL_SECONDS=5
ICHECK_COLLECTOR_LEASE_SECONDS=60
ICHECK_COLLECTOR_MAX_ASSIGNMENTS=1
ICHECK_COLLECTOR_HTTP_ALLOWED_HOSTS=inventory.example.internal
ICHECK_COLLECTOR_EXPORTER_ALLOWED_HOSTS=127.0.0.1,localhost
ICHECK_COLLECTOR_SNMP_ALLOWED_TARGETS=10.0.0.0/8,192.168.0.0/16
ICHECK_COLLECTOR_WINDOWS_EXPORTER_ALLOWED_HOSTS=10.20.0.0/16
ICHECK_COLLECTOR_WINDOWS_ALLOWED_TARGETS=10.20.0.0/16
ICHECK_COLLECTOR_PSRP_ALLOWED_PORTS=5986
ICHECK_COLLECTOR_PSRP_AUTH=ntlm
ICHECK_COLLECTOR_PSRP_CONFIGURATION_NAME=Microsoft.PowerShell
# ICHECK_COLLECTOR_PSRP_CA_FILE=/etc/icheck/pki/windows-winrm-ca.pem
ICHECK_COLLECTOR_REGISTRATION_TOKEN_FILE=/etc/icheck/secrets/collector-registration-token
ICHECK_CREDENTIAL_VAULT_ADDR=https://vault.example.internal
ICHECK_CREDENTIAL_VAULT_TOKEN_FILE=/etc/icheck/secrets/vault-token
ICHECK_CREDENTIAL_VAULT_NAMESPACE=operations
ICHECK_CREDENTIAL_VAULT_TIMEOUT_SECONDS=5
ICHECK_CREDENTIAL_ALLOW_ENVIRONMENT=false
ICHECK_METRICS_ALLOWED_HOSTS=prometheus.example.internal,metrics.example.internal
ICHECK_LOGS_ALLOWED_HOSTS=loki.example.internal
ICHECK_AI_ALLOWED_HOSTS=ai-gateway.example.internal
# Optional managed OpenRouter keys: provision a separate 32-byte server encryption key.
# SQL contains authenticated ciphertext only; never set an API token here for managed setup.
ICHECK_AI_MANAGED_SECRET_KEY_FILE=
# Public reference research (separate from the model provider and device gateway).
# Brave is the recommended managed search API; no paid provider is enabled by default.
ICHECK_RESEARCH_ENABLED=true
ICHECK_RESEARCH_PROVIDER=unconfigured
# For Brave: set PROVIDER=brave and provision a service-owned 0600 key file.
ICHECK_RESEARCH_API_KEY_FILE=
# Alternative: PROVIDER=searxng and a public HTTPS /search endpoint with JSON enabled.
ICHECK_RESEARCH_SEARXNG_URL=
ICHECK_RESEARCH_TIMEOUT_SECONDS=12
ICHECK_MCP_ALLOWED_HOSTS=mcp-gateway.example.internal
ICHECK_MCP_OAUTH_ALLOWED_HOSTS=mcp-gateway.example.internal,login.example.internal
ICHECK_MCP_OAUTH_REDIRECT_URI=https://api.icheck.example.internal/api/v1/mcp/oauth/callback
ICHECK_MCP_OAUTH_SUCCESS_URL=https://icheck.example.internal
ICHECK_MCP_OAUTH_CLIENT_METADATA_URL=https://api.icheck.example.internal/api/v1/mcp/oauth/client-metadata
ICHECK_MCP_OAUTH_TRANSACTION_SECRET_FILE=/etc/icheck/secrets/mcp-oauth-transaction-key
ICHECK_MCP_OAUTH_TIMEOUT_SECONDS=10
ICHECK_MCP_OAUTH_TRANSACTION_TTL_MINUTES=10
ICHECK_MCP_OAUTH_MAX_PENDING_TRANSACTIONS=10000
ICHECK_CAPABILITY_CATALOG_ALLOWED_HOSTS=capabilities.example.internal
ICHECK_ECOSYSTEM_TRANSPORT_ALLOWED_HOSTS=witness.example.internal,production-api.example.internal
ICHECK_REPORT_ARCHIVE_ALLOWED_HOSTS=archive.example.internal
ICHECK_RECOVERY_SIGNING_ALLOWED_HOSTS=recovery-signer.example.internal
ICHECK_SERVER_SECRET_VAULT_ADDRESS=https://vault.example.internal
ICHECK_SERVER_SECRET_VAULT_TOKEN_FILE=/etc/icheck/secrets/control-plane-vault-token
ICHECK_SERVER_SECRET_VAULT_NAMESPACE=operations
ICHECK_SERVER_SECRET_VAULT_TIMEOUT_SECONDS=5
ICHECK_ARTIFACT_SIGNATURE_POLICY=optional
ICHECK_REQUIRE_GOVERNED_CHANGE_CONTRACTS=false
ICHECK_ENABLE_REVIEWED_CHANGE_EXECUTION=false
ICHECK_ENABLE_REVIEWED_ROLLBACK_EXECUTION=false
# Enable only after native PostgreSQL disposition custody acceptance.
ICHECK_ENABLE_MCP_WRITE_DISPOSITION_CUSTODY=false
ICHECK_ENABLE_REVIEWED_SITUATION_CLOSURE=false
ICHECK_ENABLE_REVIEWED_SOURCE_REPLACEMENT=false
ICHECK_ENABLE_REPLACEMENT_RECOVERY=false
ICHECK_ENABLE_REPLACEMENT_SITUATION_CLOSURE=false
ICHECK_AI_PROVIDER_TOKEN=replace-with-provider-token
ICHECK_AGENT_WORKER_NAME=agent-worker-local-01
ICHECK_AGENT_WORKER_CAPABILITIES=openai_compatible,mcp
ICHECK_AGENT_WORKER_LEASE_SECONDS=300
ICHECK_AGENT_WORKER_POLL_SECONDS=2
ICHECK_MCP_ATTESTOR_REGISTRATION_TOKEN_FILE=
ICHECK_MCP_ATTESTOR_NAME=mcp-attestor-local-01
ICHECK_MCP_ATTESTOR_MAX_ASSIGNMENTS=4
ICHECK_MCP_ATTESTOR_LEASE_SECONDS=120
ICHECK_MCP_ATTESTOR_POLL_SECONDS=2
ICHECK_MCP_ATTESTOR_ALLOW_INSECURE_CONTROL_PLANE=false
ICHECK_WORKFLOW_DISPATCH_BATCH_SIZE=20
ICHECK_WORKFLOW_DISPATCH_POLL_SECONDS=2
ICHECK_PROJECTION_WORKER_NAME=projection-worker-local-01
ICHECK_PROJECTION_WORKER_BATCH_SIZE=20
ICHECK_PROJECTION_WORKER_LEASE_SECONDS=120
ICHECK_PROJECTION_WORKER_POLL_SECONDS=1
ICHECK_ECOSYSTEM_TRANSPORT_WORKER_NAME=ecosystem-transport-worker-local-01
