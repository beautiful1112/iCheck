ICHECK_DATABASE_URL=postgresql+psycopg://icheck:icheck@localhost:5432/icheck
ICHECK_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ICHECK_AUTO_CREATE_SCHEMA=true
ICHECK_COLLECTOR_REGISTRATION_TOKEN=replace-with-a-long-random-bootstrap-token
NEXT_PUBLIC_ICHECK_API_URL=http://localhost:8000/api/v1
ICHECK_CONTROL_PLANE_URL=http://localhost:8000
ICHECK_COLLECTOR_NAME=collector-local-01
ICHECK_COLLECTOR_SITE=LOCAL
ICHECK_COLLECTOR_CAPABILITIES=http_json,snmp_exporter,windows_exporter
ICHECK_COLLECTOR_POLL_SECONDS=5
ICHECK_COLLECTOR_LEASE_SECONDS=60
ICHECK_COLLECTOR_MAX_ASSIGNMENTS=1
ICHECK_COLLECTOR_HTTP_ALLOWED_HOSTS=inventory.example.internal
ICHECK_COLLECTOR_EXPORTER_ALLOWED_HOSTS=127.0.0.1,localhost
ICHECK_COLLECTOR_SNMP_ALLOWED_TARGETS=10.0.0.0/8,192.168.0.0/16
ICHECK_COLLECTOR_WINDOWS_EXPORTER_ALLOWED_HOSTS=10.20.0.0/16
ICHECK_COLLECTOR_WINDOWS_ALLOWED_TARGETS=10.20.0.0/16
ICHECK_COLLECTOR_REGISTRATION_TOKEN_FILE=/etc/icheck/secrets/collector-registration-token
ICHECK_METRICS_ALLOWED_HOSTS=prometheus.example.internal,metrics.example.internal
ICHECK_AI_ALLOWED_HOSTS=ai-gateway.example.internal
ICHECK_AI_PROVIDER_TOKEN=replace-with-provider-token
